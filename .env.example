# ============================================
# Document Tampering Detection — Configuration
# ============================================
# Copy this file to .env and fill in your values.
# All settings are optional — the system works with defaults.

# ── API Server ──
API_KEY=                          # Set to require authentication on the API
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ── Email Alerts (AWS SES) ──
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=fraud-alerts@yourcompany.com
ALERT_EMAIL_TO=security-team@yourcompany.com
AWS_SES_REGION=us-east-1

# ── Slack Alerts ──
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── SMS Alerts (Twilio) ──
ALERT_SMS_ENABLED=false
ALERT_TWILIO_SID=your_account_sid
ALERT_TWILIO_TOKEN=your_auth_token
ALERT_TWILIO_FROM=+1234567890
ALERT_TWILIO_TO=+0987654321

# ── Generic Webhook ──
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://your-api.com/webhooks/fraud-alert

# ── Alert Thresholds ──
ALERT_TIERS=HIGH                  # Comma-separated: LOW,MEDIUM,HIGH

# ── Dashboard (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
